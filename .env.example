# Database ZKTeco (SQL Server)
DB_HOST=192.168.1.10
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=ganti-password
DB_NAME=attendance_db

# Telegram
TG_TOKEN=ganti-token-bot
# Notifikasi log akses dikirim lewat bot lain ke satu chat.
# Kosongkan keduanya untuk mematikan notifikasi.
TG_NOTIFY_TOKEN=ganti-token-bot-notifier
TG_NOTIFY_CHAT=ganti-chat-id-penerima
# Nama tampilan chat pada teks notifikasi. Format: chatId=nama
TG_CHAT_NAMES=100000001=Budi,-100000002=Grup
# Kosong = semua chat boleh mengakses. Isi chat id dipisah koma untuk membatasi.
ALLOWED_CHATS=

# Dept head hanya melihat absensi departemennya sendiri.
# Format: chatId=nama atau id departemen, dipisah koma.
# Contoh: DEPT_HEADS=100000001=IT,100000003=HR
# Chat yang ada di DEPT_HEADS selalu dibatasi, walau juga ada di ALLOWED_CHATS.
DEPT_HEADS=

# Departemen yang tidak dihitung sebagai karyawan aktif (dipisah koma).
# Contoh: EXCLUDE_DEPARTMENTS=FORMER STAFF
EXCLUDE_DEPARTMENTS=

# Aturan keterlambatan dan lembur
LATE_TOLERANCE_MIN=10
# Punch dalam X menit sebelum jam pulang dianggap absen pulang, bukan absen masuk.
CHECKOUT_NEAR_MIN=60
# Hari tanpa jadwal yang diisi lebih dari batas ini dihitung lembur.
LEMBUR_MIN_MEN=240
SCHEDULE_FROM_DB=true
BASELINE_DAYS=30

# Zona waktu untuk menentukan "hari ini"
TZ=Asia/Jakarta
